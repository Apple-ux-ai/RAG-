# 千问大模型 API Key（必填，缺失会启动失败）
DASHSCOPE_API_KEY=sk-your-key-here

# CORS 允许的来源，公网部署务必改成你的 web 域名（逗号分隔），不要留 *
ALLOWED_ORIGINS=https://your-web-domain.com

# 可选：调用方 Token 鉴权
# 注意：api.py 里当前把 API_TOKEN 鉴权注释掉了（等于免鉴权）。
# 公网暴露前请启用（取消 api.py 里的 verify_token 注释并与此处一致），
# 或用 Nginx 做 basic auth / IP 白名单替代。
# API_TOKEN=your-secret-token

# 客户状态仅从请求 history 推导，不需要数据库路径配置。
# 多 worker / 多实例请每次传完整 history，并由调用方处理跨实例消息去重。

# 本机 IM 兼容接入，仅用于 /v1/chat 与 /v1/delivery/ack；务必换成长随机值
RAG_CHAT_TOKEN=
RAG_TENANT_ID=indonesia_brother
# 可选：投递账本位置，默认 data/rag_delivery.db
# RAG_DELIVERY_DB=data/rag_delivery.db
